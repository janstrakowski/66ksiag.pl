{
  "name": "66ksiag",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-wrangler-assets.mjs",
    "build": "bash scripts/build-dist.sh",
    "dev": "bash scripts/dev-serve.sh",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "android:build": "bash scripts/android-build.sh",
    "android:install": "bash scripts/android-install.sh",
    "android:play:internal": "bash scripts/android-play-internal.sh",
    "lfs:sync-r2": "node scripts/sync-lfs-to-r2.mjs",
    "lfs:use-r2": "node scripts/git-lfs-r2.mjs --install-git-config",
    "lfs:worker:deploy": "npx wrangler deploy -c tools/lfs-r2-worker/wrangler.toml",
    "harness": "bash scripts/start-harness.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.2",
    "vitest": "^4.1.2",
    "wrangler": "4.149.0"
  }
}
