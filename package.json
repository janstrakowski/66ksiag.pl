{
  "name": "66ksiag",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build-dist.sh",
    "dev": "bash scripts/dev-serve.sh",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:production": "bash ci/production-deploy.sh",
    "deploy:preview": "bash ci/preview-deploy.sh",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "android:build": "bash scripts/android-build.sh",
    "android:install": "bash scripts/android-install.sh",
    "harness": "bash scripts/start-harness.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.135.0"
  }
}
