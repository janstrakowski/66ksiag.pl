#!/usr/bin/env bash
# Kept so ci/pi/install-hooks.sh can replace an older hook that deployed.
# Production deploy is Origin CI on push to main (ci/production-deploy.sh).
set -euo pipefail

while read -r _oldrev _newrev refname; do
  if [[ "$refname" == "refs/heads/main" ]]; then
    echo "[ci] ignoring ${refname} on the Pi. Push main to Origin; that runs wrangler deploy."
  fi
done
